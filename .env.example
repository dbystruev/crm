# Leave both Supabase values unset (or empty) to run the local demo backend.
# The demo needs no account and stores its data in this browser only.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: show the one-click demo login buttons when Supabase IS configured.
# Enable only on a staging/demo project that has run supabase/seed.sql.
# Leave false or unset in production. Never seed demo accounts in production.
VITE_SHOW_DEMO_LOGIN=false
